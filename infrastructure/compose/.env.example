# Generated/filled by ./scripts/bootstrap.sh — do not commit .env
# Paths must be absolute. Bootstrap sets them from the git checkout location.

# Absolute path to this repository on the host
STUDIO_HOST_ROOT=

# Absolute path for databases, workspaces, OpenWrt trees, and caches
DATA_ROOT=

# gid of /var/run/docker.sock so uid 1000 can talk to the host Docker daemon
DOCKER_GID=

HOST_BIND=127.0.0.1
HTTP_PORT=8080
APP_URL=http://127.0.0.1:8080
APP_ENV=local
APP_DEBUG=true
APP_KEY=

POSTGRES_DB=openwrt_ai_studio
POSTGRES_USER=studio
POSTGRES_PASSWORD=change-me

REDIS_PASSWORD=change-me

MINIO_ROOT_USER=studio
MINIO_ROOT_PASSWORD=change-me

AI_GATEWAY_URL=https://freellmapi.ai101.eu.org
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
AI_GATEWAY_TIMEOUT=300
# Extra attempts after 502/503/504/timeout. 0 = do not retry.
AI_GATEWAY_RETRIES=3
AI_TOOL_MODE=auto
# 0 = no tool-step cap (Cursor-style). A positive number caps each turn.
AI_MAX_ITERATIONS=0

BUILD_DRIVER=docker
BUILD_BUILDROOT_IMAGE=openwrt-ai-buildroot:24.10
BUILD_CPUS=2
BUILD_MEMORY=1g
BUILD_FIRMWARE_CPUS=4
BUILD_FIRMWARE_MEMORY=8g
BUILD_FIRMWARE_TIMEOUT=7200

OPENHANDS_URL=
OPENHANDS_SESSION_KEY=
